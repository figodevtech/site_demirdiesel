# =============================================================================
# DEMIR DIESEL - STOREFRONT
# Copie para .env.local e preencha. Nunca commite chaves reais.
# =============================================================================

# Aplicacao / SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Identidade publica da empresa (opcional; ha valores padrao no codigo)
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Demir Diesel Pecas e Servicos Ltda.
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_PHONE=+55 83 98832-3883
NEXT_PUBLIC_COMPANY_PHONE_DISPLAY=(83) 98832-3883
NEXT_PUBLIC_COMPANY_EMAIL=contato@demirdiesel.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5583988323883
NEXT_PUBLIC_WHATSAPP_DISPLAY=(83) 98832-3883

# Banco EXCLUSIVO da loja: Auth, clientes, enderecos, favoritos e pedidos.
# Nao aponte estas variaveis para o banco do ERP.
NEXT_PUBLIC_STORE_SUPABASE_URL=https://SEU-PROJETO-LOJA.supabase.co
NEXT_PUBLIC_STORE_SUPABASE_ANON_KEY=
STORE_SUPABASE_SERVICE_ROLE_KEY=

# Compatibilidade temporaria com a configuracao antiga.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ERP -> loja: segredo do endpoint que recebe catalogo, preco e estoque.
ERP_CATALOG_SYNC_SECRET=

# ERP <-> loja: segredo exclusivo para pedidos, rastreio e NF-e.
# Use o mesmo valor em STOREFRONT_ORDER_SYNC_SECRET no ERP.
ERP_ORDER_SYNC_SECRET=

# Central -> loja: configuração versionada de comissão.
CENTRAL_STOREFRONT_CONFIG_URL=https://central.figosoftwares.com.br/api/v1/storefront/payment-config
CENTRAL_INSTALLATION_ID=
CENTRAL_STOREFRONT_TOKEN=

# Asaas (somente servidor; nunca use NEXT_PUBLIC_)
# Use sandbox durante a homologacao e production somente depois dos testes.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Token forte configurado no webhook do painel Asaas (minimo recomendado: 32 caracteres).
ASAAS_WEBHOOK_TOKEN=
# Opcional: sobrescreve a URL da API, normalmente deixe comentado.
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3

# Contato/e-mail (opcional no fluxo atual)
RESEND_API_KEY=
EMAIL_FROM=Demir Diesel <contato@demirdiesel.com.br>

